# Supabase — required for the booking flow to persist data. Without these set, the
# booking modal will still render but /api/booking submissions will fail server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — best-effort secondary sync of bookings/appointments to a Google Sheet via
# an Apps Script web app. Leave unset to skip this integration entirely.
GOOGLE_SHEETS_SCRIPT_URL=

# Optional — external booking-provider URL (e.g. Calendly). Required when
# businessConfig.bookingMode is set to "external" — every CTA links here instead of
# opening the in-page booking modal.
NEXT_PUBLIC_BOOKING_URL=

# Optional — lead-capture form webhook endpoint.
NEXT_PUBLIC_LEAD_FORM_ENDPOINT_URL=

# Optional — footer email-updates capture webhook endpoint. Its own separate Apps
# Script/Sheet from the lead form and booking sync, so subscriber emails stay distinct.
NEXT_PUBLIC_FOOTER_SIGNUP_ENDPOINT_URL=

# Optional — best-effort sync of /get-started clone-request leads to a separate Google
# Sheet via its own Apps Script web app. Leave unset to skip this integration entirely.
GOOGLE_SHEETS_INTAKE_SCRIPT_URL=

# Optional — best-effort webhook notify (Slack/email/Zapier, etc.) fired on new
# /get-started clone-request submissions. Leave unset to skip this integration entirely.
INTAKE_NOTIFY_WEBHOOK_URL=
